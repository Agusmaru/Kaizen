@model IEnumerable<RevisionKaizen>
@{ViewData["Titulo"]="Revisiones";}<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li><li class="breadcrumb-item active">Revisiones</li></ol></nav><div class="page-header"><div><h1 class="h3 mb-1">Revisiones</h1><p class="mb-0">Consultá lo que funcionó y los ajustes realizados.</p></div></div>@if(!Model.Any()){<div class="empty-state"><h2 class="h5">Todavía no hay revisiones</h2><p>Podés realizar una revisión desde el detalle de una meta.</p><a class="btn btn-primary" asp-controller="Goals" asp-action="Index">Ver metas</a></div>}else{<div class="card"><div class="table-responsive"><table class="table mb-0"><thead class="table-light"><tr><th>Meta</th><th>Período</th><th>Cumplimiento</th><th>Qué funcionó</th><th>Ajuste</th></tr></thead><tbody>@foreach(var r in Model){var color=r.PorcentajeCumplimiento>=80?"success":r.PorcentajeCumplimiento>=50?"warning":"danger";<tr><td><a asp-controller="Goals" asp-action="Details" asp-route-id="@r.MetaId">@r.Meta!.Titulo</a></td><td>@r.InicioPeriodo.ToString("dd/MM") - @r.FinPeriodo.ToString("dd/MM/yyyy")</td><td><span class="badge text-bg-@color">@r.PorcentajeCumplimiento%</span></td><td>@r.QueFunciono</td><td>@r.AjustePequeno</td></tr>}</tbody></table></div></div>}
