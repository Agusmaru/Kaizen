@model KaizenReviewFormViewModel
@{ViewData["Titulo"]="Revisión Kaizen";var color=Model.PorcentajeCumplimiento>=80?"success":Model.PorcentajeCumplimiento>=50?"warning":"danger";}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li><li class="breadcrumb-item"><a asp-controller="Goals" asp-action="Details" asp-route-id="@Model.MetaId">@Model.GoalTitle</a></li><li class="breadcrumb-item active">Revisión Kaizen</li></ol></nav><div class="page-header"><div><h1 class="h3 mb-1">Revisión periódica Kaizen</h1><p class="mb-0">@Model.GoalTitle · período inclusivo del @Model.InicioPeriodo.ToString("dd/MM/yyyy") al @Model.FinPeriodo.ToString("dd/MM/yyyy")</p></div></div>
@if(Model.IsEarly){<div class="alert alert-warning">La revisión estaba planificada para el @Model.PlannedReviewDate.ToString("dd/MM/yyyy"). Podés realizarla anticipadamente si lo necesitás.</div>}
<form id="review-form" method="post"><input asp-for="MetaId" type="hidden"/><input asp-for="InicioPeriodo" type="hidden"/><input asp-for="FinPeriodo" type="hidden"/><input asp-for="EstadoMetaInicial" type="hidden"/><div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
<section class="card mb-4"><div class="card-header bg-white"><h2 class="section-title mb-0">Resultados</h2></div><div class="card-body"><div class="alert alert-@color"><strong>@Model.PorcentajeCumplimiento% — @Model.Completed de @Model.Planned acciones realizadas</strong><div>@Model.Missed no realizadas · @Model.Pending pendientes</div></div><div class="row g-3 mb-3"><div class="col-md-4"><strong>Mejor cumplimiento</strong><div>@(Model.BestAction??"Todavía no hay suficientes registros")</div></div><div class="col-md-4"><strong>Mayores dificultades</strong><div>@(Model.DifficultAction??"Todavía no hay suficientes registros")</div></div><div class="col-md-4"><strong>Días con más incumplimientos</strong><div>@(string.IsNullOrWhiteSpace(Model.MostMissedDays)?"No hubo incumplimientos registrados":Model.MostMissedDays)</div></div></div>@if(Model.PreviousPercentage is null){<p class="text-muted">Esta es la primera revisión de la meta.</p>}else{<p>Revisión anterior: <strong>@Model.PreviousPercentage%</strong>. Diferencia: <strong>@(Model.PorcentajeCumplimiento-Model.PreviousPercentage)%</strong>.</p>}<div class="table-responsive"><table class="table"><thead><tr><th>Acción</th><th>Resultado</th><th>Detalle</th><th>Cantidad</th></tr></thead><tbody>@foreach(var item in Model.ActionResults){<tr><td>@item.Nombre</td><td>@item.Percentage% — @item.Completed de @item.Planned</td><td>@item.Missed no realizadas · @item.Pending pendientes</td><td>@if(item.ExpectedTotal is not null){<span>@(item.ActualTotal??0) de @item.ExpectedTotal @item.Unit</span>}else{<span>No medible</span>}</td></tr>}</tbody></table></div><h3 class="h6">Notas del período</h3>@if(!Model.Notes.Any()){<p>No se registraron notas durante este período.</p>}else{<ul>@foreach(var note in Model.Notes){<li>@note</li>}</ul>}</div></section>
<section class="card mb-4"><div class="card-header bg-white"><h2 class="section-title mb-0">Reflexión</h2></div><div class="card-body"><div class="row g-3"><div class="col-md-6"><label asp-for="QueFunciono" class="form-label">¿Qué funcionó bien? *</label><textarea asp-for="QueFunciono" class="form-control" rows="3"></textarea><span asp-validation-for="QueFunciono" class="text-danger"></span></div><div class="col-md-6"><label asp-for="QueDificulto" class="form-label">¿Qué dificultades aparecieron? *</label><textarea asp-for="QueDificulto" class="form-control" rows="3"></textarea><span asp-validation-for="QueDificulto" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Aprendizaje" class="form-label">¿Qué aprendiste durante este período? *</label><textarea asp-for="Aprendizaje" class="form-control" rows="3"></textarea><span asp-validation-for="Aprendizaje" class="text-danger"></span></div><div class="col-md-6"><label asp-for="CambioProximoPeriodo" class="form-label">¿Qué querés cambiar para el próximo período? *</label><textarea asp-for="CambioProximoPeriodo" class="form-control" rows="3"></textarea><span asp-validation-for="CambioProximoPeriodo" class="text-danger"></span></div><div class="col-12"><label asp-for="NotasAdicionales" class="form-label">Observaciones adicionales</label><textarea asp-for="NotasAdicionales" class="form-control" rows="2"></textarea></div></div></div></section>
<section class="card mb-4"><div class="card-header bg-white"><h2 class="section-title mb-0">Ajustes de acciones</h2></div><div class="card-body">@for(var i=0;i<Model.Decisions.Count;i++){<div class="border rounded p-3 mb-3 decision"><input asp-for="Decisions[i].AccionPlanificadaId" type="hidden"/><input asp-for="Decisions[i].ActionName" type="hidden"/><input asp-for="Decisions[i].CurrentVersion" type="hidden"/><input asp-for="Decisions[i].CurrentConfiguration" type="hidden"/><h3 class="h6">@Model.Decisions[i].ActionName <span class="badge text-bg-secondary">versión @Model.Decisions[i].CurrentVersion</span></h3><p class="small"><strong>Configuración anterior:</strong> @Model.Decisions[i].CurrentConfiguration</p><div class="row g-2"><div class="col-md-3"><label class="form-label">Decisión *</label><select asp-for="Decisions[i].Tipo" class="form-select decision-type"><option value="0">Mantener</option><option value="1">Simplificar</option><option value="2">Aumentar</option><option value="3">Pausar</option><option value="4">Reemplazar</option><option value="5">Completar</option></select></div><div class="col-md-3"><label class="form-label">Aplicar desde *</label><input asp-for="Decisions[i].FechaVigencia" type="date" class="form-control"/><span asp-validation-for="Decisions[i].FechaVigencia" class="text-danger"></span></div><div class="col-md-6"><label class="form-label">Motivo</label><input asp-for="Decisions[i].Motivo" class="form-control"/><span asp-validation-for="Decisions[i].Motivo" class="text-danger"></span></div><div class="col-md-4"><label class="form-label">Nuevo nombre</label><input asp-for="Decisions[i].NewName" class="form-control"/><span asp-validation-for="Decisions[i].NewName" class="text-danger"></span></div><div class="col-md-2"><label class="form-label">Frecuencia</label><select asp-for="Decisions[i].NewFrequency" class="form-select"><option value="0">Diaria</option><option value="1">Días elegidos</option><option value="2">Semanal</option><option value="3">Fecha específica</option></select></div><div class="col-md-2"><label class="form-label">Días</label><input asp-for="Decisions[i].NewWeekdays" class="form-control"/></div><div class="col-md-2"><label class="form-label">Cantidad</label><input asp-for="Decisions[i].NewTargetAmount" type="number" min="0" step="any" class="form-control"/></div><div class="col-md-2"><label class="form-label">Unidad</label><input asp-for="Decisions[i].NewMetricUnit" class="form-control"/></div><div class="col-md-3"><label class="form-label">Horario</label><input asp-for="Decisions[i].NewTime" type="time" class="form-control"/></div><div class="col-md-3"><label class="form-label">Nueva fecha final</label><input asp-for="Decisions[i].NewEndDate" type="date" class="form-control"/></div><div class="col-md-3"><label class="form-label">Reanudación estimada</label><input asp-for="Decisions[i].FechaReanudacion" type="date" class="form-control"/></div></div><div class="mt-2 small"><strong>Nuevo valor propuesto:</strong> los campos anteriores se aplicarán desde la fecha efectiva únicamente si la decisión crea una versión nueva.</div></div>}</div></section>
<section class="card mb-4"><div class="card-header bg-white"><h2 class="section-title mb-0">Confirmación</h2></div><div class="card-body"><p><strong>Período:</strong> @Model.InicioPeriodo.ToString("dd/MM/yyyy") al @Model.FinPeriodo.ToString("dd/MM/yyyy")</p><p><strong>Resultado:</strong> @Model.PorcentajeCumplimiento% — @Model.Completed de @Model.Planned</p><p><strong>Próxima revisión:</strong> @(Model.FinPeriodo.AddDays(7).ToString("dd/MM/yyyy")) (según frecuencia de la meta)</p><p class="mb-0">Se registrará una decisión por cada acción y los cambios comenzarán en sus fechas efectivas.</p></div></section><div class="d-flex gap-2"><button id="save-review" class="btn btn-primary" type="submit"><span class="spinner-border spinner-border-sm d-none"></span> Guardar revisión y aplicar ajustes</button><a class="btn btn-outline-secondary" asp-controller="Goals" asp-action="Details" asp-route-id="@Model.MetaId">Cancelar</a></div></form>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>(()=>{const form=document.getElementById('review-form'),button=document.getElementById('save-review'),spinner=button.querySelector('.spinner-border');let sending=false;form.addEventListener('submit',event=>{if(window.jQuery&&!$(form).valid()){sending=false;button.disabled=false;spinner.classList.add('d-none');return;}if(sending){event.preventDefault();return;}sending=true;button.disabled=true;spinner.classList.remove('d-none');});window.addEventListener('pageshow',()=>{sending=false;button.disabled=false;spinner.classList.add('d-none');});})();</script>}
