@model GoalFormViewModel
@{ViewData["Titulo"]="Editar meta";}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li><li class="breadcrumb-item"><a asp-action="Index">Metas</a></li><li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">Detalle</a></li><li class="breadcrumb-item active">Editar</li></ol></nav><div class="page-header"><div><h1 class="h3 mb-1">Editar meta</h1><p class="mb-0">Actualizá la información general de la meta.</p></div></div>
<div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-2"><span>Las acciones se modifican conservando sus versiones y resultados anteriores.</span><a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@Model.Id">Modificar acción</a></div>
<div class="card"><div class="card-body"><form method="post"><partial name="_Form" model="Model"/><div class="d-flex gap-2"><button class="btn btn-primary">Guardar cambios</button><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancelar</a></div></form></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
