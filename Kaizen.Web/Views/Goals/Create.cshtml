@model GoalSetupViewModel
@{ViewData["Titulo"]=Model.Id==0?"Nueva meta":"Continuar borrador";}
@section Styles { <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" /> }
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li><li class="breadcrumb-item"><a asp-action="Index">Metas</a></li><li class="breadcrumb-item active">@(Model.Id==0?"Nueva meta":"Continuar borrador")</li></ol></nav>
<header class="page-hero form-hero"><div><span class="page-eyebrow">Diseñá tu próximo cambio</span><h1>@(Model.Id==0?"Nueva meta":"Continuar borrador")</h1><p>Avanzá paso a paso. Podés guardar lo que completes y continuar en otro momento.</p></div><div class="form-progress-hint"><strong>4 pasos</strong><span>Meta · Análisis · Acciones · Resumen</span></div></header>
<form id="goal-setup-form" class="setup-form" asp-controller="Goals" asp-action="Create" method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
<section class="card mb-4 setup-section" data-required-fields="Titulo,Descripcion,AreaPersonalId,MetricaProgreso"><div class="card-header bg-white d-flex justify-content-between"><div><h2 class="section-title mb-1">1. Información de la meta</h2><p class="small mb-0">Definí qué querés lograr y cómo medirlo. Los campos obligatorios se indican con *.</p></div><span class="section-state badge text-bg-warning">Incompleta</span></div><div class="card-body"><div class="row g-3"><div class="col-md-6"><label asp-for="Titulo" class="form-label">Nombre *</label><input asp-for="Titulo" class="form-control"/><span asp-validation-for="Titulo" class="text-danger"></span></div><div class="col-md-6"><label asp-for="AreaPersonalId" class="form-label">Área *</label><select asp-for="AreaPersonalId" asp-items="ViewBag.AreaPersonalId" class="form-select"><option value="">Seleccioná un área</option></select><span asp-validation-for="AreaPersonalId" class="text-danger"></span></div><div class="col-12"><label asp-for="Descripcion" class="form-label">Descripción *</label><textarea asp-for="Descripcion" class="form-control" rows="2"></textarea><span asp-validation-for="Descripcion" class="text-danger"></span></div><div class="col-md-4"><label asp-for="FechaInicio" class="form-label">Fecha de inicio *</label><input asp-for="FechaInicio" type="date" class="form-control"/></div><div class="col-md-4"><label asp-for="FechaObjetivo" class="form-label">Fecha objetivo</label><input asp-for="FechaObjetivo" type="date" class="form-control"/></div><div class="col-md-4"><label asp-for="MetricaProgreso" class="form-label">Métrica o criterio de éxito *</label><input asp-for="MetricaProgreso" class="form-control"/><span asp-validation-for="MetricaProgreso" class="text-danger"></span></div></div></div></section>
<section class="card mb-4 setup-section" data-required-fields="PorQueEsImportante,SituacionActual,ResultadoEsperado,Obstaculos,MejoraMasPequena,EvidenciaMejora"><div class="card-header bg-white d-flex justify-content-between"><div><h2 class="section-title mb-1">2. Análisis inicial Kaizen</h2><p class="small mb-0">Pensá la situación actual y el primer cambio pequeño posible.</p></div><span class="section-state badge text-bg-warning">Incompleta</span></div><div class="card-body"><div class="row g-3"><div class="col-md-6"><label asp-for="SituacionActual" class="form-label">Situación actual *</label><textarea asp-for="SituacionActual" class="form-control" rows="2"></textarea><span asp-validation-for="SituacionActual" class="text-danger"></span></div><div class="col-md-6"><label asp-for="ResultadoEsperado" class="form-label">Resultado deseado *</label><textarea asp-for="ResultadoEsperado" class="form-control" rows="2"></textarea><span asp-validation-for="ResultadoEsperado" class="text-danger"></span></div><div class="col-md-6"><label asp-for="PorQueEsImportante" class="form-label">¿Por qué es importante? *</label><textarea asp-for="PorQueEsImportante" class="form-control" rows="2"></textarea><span asp-validation-for="PorQueEsImportante" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Obstaculos" class="form-label">Obstáculos o dificultades *</label><textarea asp-for="Obstaculos" class="form-control" rows="2"></textarea><span asp-validation-for="Obstaculos" class="text-danger"></span></div><div class="col-md-6"><label asp-for="QueFunciona" class="form-label">¿Qué ya está funcionando?</label><textarea asp-for="QueFunciona" class="form-control" rows="2"></textarea></div><div class="col-md-6"><label asp-for="MejoraMasPequena" class="form-label">Primer cambio pequeño *</label><textarea asp-for="MejoraMasPequena" class="form-control" rows="2"></textarea><span asp-validation-for="MejoraMasPequena" class="text-danger"></span></div><div class="col-md-8"><label asp-for="EvidenciaMejora" class="form-label">¿Cómo sabrás que estás mejorando? *</label><input asp-for="EvidenciaMejora" class="form-control"/><span asp-validation-for="EvidenciaMejora" class="text-danger"></span></div><div class="col-md-4"><label asp-for="DificultadPercibida" class="form-label">Dificultad (1 a 5)</label><input asp-for="DificultadPercibida" type="number" min="1" max="5" class="form-control"/></div></div></div></section>
<section class="card mb-4 setup-section" id="actions-section"><div class="card-header bg-white d-flex justify-content-between"><div><h2 class="section-title mb-1">3. Acciones iniciales</h2><p class="small mb-0">Agregá al menos una acción con una recurrencia clara.</p></div><span class="section-state badge text-bg-warning">Incompleta</span></div><div class="card-body"><div id="action-list">@for(var i=0;i<Model.Acciones.Count;i++){<div class="action-editor border rounded p-3 mb-3"><div class="d-flex justify-content-between mb-2"><strong>Acción <span class="action-number">@(i+1)</span></strong><button type="button" class="remove-action btn btn-outline-danger btn-sm">Eliminar</button></div><div class="row g-2"><div class="col-md-6"><label class="form-label" for="Actions_@(i)__Name">Nombre *</label><input asp-for="Acciones[i].Nombre" class="form-control action-name"/><span asp-validation-for="Acciones[i].Nombre" class="text-danger"></span></div><div class="col-md-3"><label class="form-label">Frecuencia *</label><select asp-for="Acciones[i].Frecuencia" asp-items="Html.GetEnumSelectList<FrecuenciaAccion>()" class="form-select frequency"></select></div><div class="col-md-3"><label class="form-label">Días (0=domingo)</label><input asp-for="Acciones[i].DiasSemana" class="form-control" placeholder="Ej.: 1,3,5"/></div><div class="col-md-3"><label class="form-label">Inicio *</label><input asp-for="Acciones[i].FechaInicio" type="date" class="form-control"/></div><div class="col-md-3"><label class="form-label">Finalización</label><input asp-for="Acciones[i].FechaFin" type="date" class="form-control"/></div><div class="col-md-2"><label class="form-label">Horario</label><input asp-for="Acciones[i].Hora" type="time" class="form-control"/></div><div class="col-md-2"><label class="form-label">Cantidad</label><input asp-for="Acciones[i].CantidadObjetivo" type="number" min="0" step="any" class="form-control"/></div><div class="col-md-2"><label class="form-label">Unidad</label><input asp-for="Acciones[i].UnidadMetrica" class="form-control"/></div><input asp-for="Acciones[i].DificultadEstimada" type="hidden"/></div></div>}</div><button id="add-action" type="button" class="btn btn-outline-primary">Agregar acción</button></div></section>
<section class="card mb-4 setup-section" id="summary-section"><div class="card-header bg-white d-flex justify-content-between"><div><h2 class="section-title mb-1">4. Resumen y activación</h2><p class="small mb-0">Revisá la configuración antes de activar.</p></div><span class="section-state badge text-bg-warning">Incompleta</span></div><div class="card-body"><dl class="row mb-0"><dt class="col-sm-4">Meta</dt><dd id="summary-title" class="col-sm-8">Sin nombre</dd><dt class="col-sm-4">Fecha objetivo</dt><dd id="summary-date" class="col-sm-8">Sin fecha</dd><dt class="col-sm-4">Acciones configuradas</dt><dd id="summary-actions" class="col-sm-8">0</dd><dt class="col-sm-4">Próxima revisión</dt><dd class="col-sm-8">7 días después de la activación</dd></dl></div></section>
<div class="form-actions"><div><strong>¿Todo listo?</strong><span>Al activar la meta, sus acciones aparecerán en Inicio y Calendario.</span></div><div><button name="SubmitIntent" value="draft" class="btn btn-outline-primary submit-goal" type="submit">Guardar borrador</button><button name="SubmitIntent" value="activate" class="btn btn-primary submit-goal" type="submit"><span class="spinner-border spinner-border-sm d-none"></span> Guardar y activar</button><a id="cancel-goal" class="btn btn-outline-secondary" asp-action="Index">Cancelar</a></div></div></form>
<template id="action-template"><div class="action-editor border rounded p-3 mb-3"><div class="d-flex justify-content-between mb-2"><strong>Acción <span class="action-number"></span></strong><button type="button" class="remove-action btn btn-outline-danger btn-sm">Eliminar</button></div><div class="row g-2"><div class="col-md-6"><label class="form-label">Nombre *</label><input data-field="Nombre" class="form-control action-name"/></div><div class="col-md-3"><label class="form-label">Frecuencia *</label><select data-field="Frecuencia" class="form-select frequency"><option value="0">Diaria</option><option value="1">Días seleccionados</option><option value="2">Semanal</option><option value="3">Fecha específica</option></select></div><div class="col-md-3"><label class="form-label">Días (0=domingo)</label><input data-field="DiasSemana" class="form-control" placeholder="Ej.: 1,3,5"/></div><div class="col-md-3"><label class="form-label">Inicio *</label><input data-field="FechaInicio" type="date" class="form-control" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")"/></div><div class="col-md-3"><label class="form-label">Finalización</label><input data-field="FechaFin" type="date" class="form-control"/></div><div class="col-md-2"><label class="form-label">Horario</label><input data-field="Hora" type="time" class="form-control"/></div><div class="col-md-2"><label class="form-label">Cantidad</label><input data-field="CantidadObjetivo" type="number" min="0" step="any" class="form-control"/></div><div class="col-md-2"><label class="form-label">Unidad</label><input data-field="UnidadMetrica" class="form-control"/></div><input data-field="DificultadEstimada" type="hidden" value="1"/></div></div></template>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>
(()=>{const form=document.getElementById('goal-setup-form'),list=document.getElementById('action-list'),template=document.getElementById('action-template');let dirty=false,saving=false;function renumber(){[...list.querySelectorAll('.action-editor')].forEach((row,i)=>{row.querySelector('.action-number').textContent=i+1;row.querySelectorAll('[data-field]').forEach(input=>input.name=`Acciones[${i}].${input.dataset.field}`);});update();}function update(){document.querySelectorAll('.setup-section[data-required-fields]').forEach(section=>{const ok=section.dataset.requiredFields.split(',').every(name=>String(form.elements[name]?.value??'').trim());const badge=section.querySelector('.section-state');badge.textContent=ok?'Completa':'Incompleta';badge.className=`section-state badge text-bg-${ok?'success':'warning'}`;});const actions=[...list.querySelectorAll('.action-name')].filter(x=>x.value.trim()).length,actionBadge=document.querySelector('#actions-section .section-state');actionBadge.textContent=actions?'Completa':'Incompleta';actionBadge.className=`section-state badge text-bg-${actions?'success':'warning'}`;document.getElementById('summary-title').textContent=form.elements.Titulo.value||'Sin nombre';document.getElementById('summary-date').textContent=form.elements.FechaObjetivo.value||'Sin fecha';document.getElementById('summary-actions').textContent=actions;const allComplete=[...document.querySelectorAll('.setup-section:not(#summary-section) .section-state')].every(x=>x.textContent==='Completa'),summary=document.querySelector('#summary-section .section-state');summary.textContent=allComplete?'Lista para activar':'Incompleta';summary.className=`section-state badge text-bg-${allComplete?'success':'warning'}`;}document.getElementById('add-action').addEventListener('click',()=>{list.appendChild(template.content.cloneNode(true));dirty=true;renumber();});list.addEventListener('click',e=>{if(!e.target.closest('.remove-action'))return;if(list.children.length===1){list.querySelector('.action-name').value='';}else e.target.closest('.action-editor').remove();dirty=true;renumber();});form.addEventListener('input',()=>{dirty=true;update();});form.addEventListener('submit',e=>{if(saving){e.preventDefault();return;}saving=true;dirty=false;document.querySelectorAll('.submit-goal').forEach(x=>x.disabled=true);const spinner=e.submitter?.querySelector('.spinner-border');spinner?.classList.remove('d-none');});window.addEventListener('beforeunload',e=>{if(dirty&&!saving){e.preventDefault();e.returnValue='';}});document.getElementById('cancel-goal').addEventListener('click',()=>{if(!dirty)return;saving=false;});renumber();})();
document.querySelectorAll('#action-list .frequency').forEach(select=>[...select.options].forEach(option=>option.textContent=({Daily:'Diaria',SelectedWeekdays:'Días seleccionados',Weekly:'Semanal',SpecificDate:'Fecha específica'})[option.textContent]||option.textContent));document.getElementById('goal-setup-form').addEventListener('submit',event=>{const intent=document.createElement('input');intent.type='hidden';intent.name='SubmitIntent';intent.value=event.submitter?.value||'activate';event.currentTarget.appendChild(intent);document.querySelectorAll('#action-list .action-editor').forEach((row,index)=>row.querySelectorAll('[name^="Acciones["]').forEach(input=>input.name=`Acciones[${index}].${input.name.split('.').pop()}`));},{capture:true});
</script>}
