@model ActionEditViewModel
@{ViewData["Titulo"]="Modificar acción";}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Metas</a></li><li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.MetaId">Detalle</a></li><li class="breadcrumb-item active">Modificar acción</li></ol></nav>
<div class="page-header"><div><h1 class="h3 mb-1">Modificar acción</h1><p class="mb-0">Los registros anteriores conservarán la configuración que tenía la acción en ese momento.</p></div></div>
@if(!Model.CanEdit){<div class="alert alert-warning"><strong>Esta es una versión histórica y no puede modificarse.</strong></div>}
<div class="row g-4"><div class="col-lg-8"><div class="card"><div class="card-body"><form asp-action="EditAction" asp-route-id="@Model.ActionId" method="post" id="editActionForm">
<input asp-for="ActionId" type="hidden"/><input asp-for="MetaId" type="hidden"/><input asp-for="OriginalVersion" type="hidden"/><input asp-for="SubmitIntent" type="hidden" value="@(Model.Changes.Any()?"confirm":"preview")"/><div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
<fieldset disabled="@(!Model.CanEdit)"><div class="mb-3"><label asp-for="Nombre" class="form-label">Nombre</label><input asp-for="Nombre" class="form-control"/><span asp-validation-for="Nombre" class="text-danger"></span></div><div class="mb-3"><label asp-for="Descripcion" class="form-label">Descripción</label><textarea asp-for="Descripcion" class="form-control" rows="2"></textarea><span asp-validation-for="Descripcion" class="text-danger"></span></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="Frecuencia" class="form-label">Frecuencia</label><select asp-for="Frecuencia" class="form-select" id="frequency"><option value="0">Diaria</option><option value="1">Días específicos</option><option value="2">Semanal</option><option value="3">Fecha específica</option></select></div><div class="col-md-6 mb-3"><label asp-for="Hora" class="form-label">Horario</label><input asp-for="Hora" type="time" class="form-control"/></div></div>
<div class="mb-3" id="weekdayPanel"><label class="form-label">Días programados</label><div class="d-flex flex-wrap gap-3">@foreach(var d in new[]{("1","Lunes"),("2","Martes"),("3","Miércoles"),("4","Jueves"),("5","Viernes"),("6","Sábado"),("0","Domingo")}){<div class="form-check"><input class="form-check-input weekday" type="checkbox" value="@d.Item1" id="day@d.Item1" checked="@((Model.DiasSemana??"").Split(',').Contains(d.Item1))"/><label class="form-check-label" for="day@d.Item1">@d.Item2</label></div>}</div><input asp-for="DiasSemana" type="hidden"/><span asp-validation-for="DiasSemana" class="text-danger"></span></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="FechaInicio" class="form-label">Fecha de inicio</label><input asp-for="FechaInicio" type="date" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="FechaFin" class="form-label">Fecha de finalización</label><input asp-for="FechaFin" type="date" class="form-control"/></div></div><div class="row"><div class="col-md-4 mb-3"><label asp-for="DificultadEstimada" class="form-label">Dificultad</label><input asp-for="DificultadEstimada" type="number" min="1" max="5" class="form-control"/></div><div class="col-md-4 mb-3"><label asp-for="CantidadObjetivo" class="form-label">Cantidad esperada</label><input asp-for="CantidadObjetivo" class="form-control"/></div><div class="col-md-4 mb-3"><label asp-for="UnidadMetrica" class="form-label">Unidad</label><input asp-for="UnidadMetrica" class="form-control"/></div></div>
<div class="row"><div class="col-md-5 mb-3"><label asp-for="FechaVigencia" class="form-label">Fecha efectiva del cambio</label><input asp-for="FechaVigencia" type="date" class="form-control"/><span asp-validation-for="FechaVigencia" class="text-danger"></span></div><div class="col-md-7 mb-3"><label asp-for="Motivo" class="form-label">Motivo de la modificación</label><textarea asp-for="Motivo" class="form-control" rows="2"></textarea><span asp-validation-for="Motivo" class="text-danger"></span></div></div></fieldset>
@if(Model.Changes.Any()){<div class="alert alert-info"><h2 class="h6">Cambios a confirmar</h2><ul class="mb-2">@foreach(var change in Model.Changes){<li>@change</li>}</ul><div><strong>Vigente desde:</strong> @Model.FechaVigencia.ToString("dd/MM/yyyy")</div><div><strong>Motivo:</strong> @Model.Motivo</div></div>@if(Model.HasRegisteredFuture){<div class="alert alert-warning">Existen ocurrencias futuras con información registrada. Se conservarán vinculadas con la versión anterior.</div>}}
@if(Model.CanEdit){<div class="d-flex gap-2"><button type="submit" class="btn btn-primary" data-submit>@(Model.Changes.Any()?"Actualizar cambios":"Revisar cambios") <span class="spinner-border spinner-border-sm d-none" data-spinner></span></button><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.MetaId">Cancelar</a></div>}</form></div></div></div>
<aside class="col-lg-4"><div class="card"><div class="card-header bg-white"><h2 class="section-title mb-0">Versiones anteriores</h2></div><div class="list-group list-group-flush">@foreach(var version in Model.Versions){<div class="list-group-item"><strong>Versión @version.Version</strong><div class="small">@version.From.ToString("dd/MM/yyyy") — @(version.To?.ToString("dd/MM/yyyy")??"actual")</div><div class="small">@version.Configuration</div><div class="small"><strong>Origen:</strong> @version.Origin</div>@if(version.Motivo is not null){<div class="small"><strong>Motivo:</strong> @version.Motivo</div>}@if(version.Id!=Model.ActionId){<a class="btn btn-outline-secondary btn-sm mt-2" asp-action="EditAction" asp-route-id="@version.Id">Ver versión histórica</a>}</div>}</div></div></aside></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>const form=document.getElementById('editActionForm'),frequency=document.getElementById('frequency'),panel=document.getElementById('weekdayPanel'),hidden=document.getElementById('DiasSemana'),checks=document.querySelectorAll('.weekday');function toggle(){panel.hidden=frequency.value!=='1'}frequency?.addEventListener('change',toggle);checks.forEach(x=>x.addEventListener('change',()=>hidden.value=[...checks].filter(c=>c.checked).map(c=>c.value).join(',')));toggle();form?.addEventListener('submit',()=>{const b=form.querySelector('[data-submit]');if(window.jQuery&&!$(form).valid()){b?.querySelector('[data-spinner]')?.classList.add('d-none');if(b)b.disabled=false;return}if(b){b.disabled=true;b.querySelector('[data-spinner]').classList.remove('d-none')}});</script>}
