@model GoalFormViewModel
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><input asp-for="Id" type="hidden"/><section class="form-section"><h2 class="h5">Información principal</h2><div class="mb-3"><label asp-for="Titulo" class="form-label">Título</label><input asp-for="Titulo" class="form-control"/><span asp-validation-for="Titulo" class="text-danger"></span></div><div class="mb-3"><label asp-for="Descripcion" class="form-label">Descripción</label><textarea asp-for="Descripcion" class="form-control" rows="3"></textarea><span asp-validation-for="Descripcion" class="text-danger"></span></div><div class="mb-3"><label asp-for="AreaPersonalId" class="form-label">Área personal</label><select asp-for="AreaPersonalId" asp-items="ViewBag.AreaPersonalId" class="form-select"><option value="0">Seleccioná un área</option></select><span asp-validation-for="AreaPersonalId" class="text-danger"></span></div></section><section class="form-section"><h2 class="h5">Situación y resultado</h2><div class="mb-3"><label asp-for="PorQueEsImportante" class="form-label">¿Por qué es importante?</label><textarea asp-for="PorQueEsImportante" class="form-control" rows="2"></textarea><span asp-validation-for="PorQueEsImportante" class="text-danger"></span></div><div class="mb-3"><label asp-for="SituacionActual" class="form-label">Situación actual</label><textarea asp-for="SituacionActual" class="form-control" rows="2"></textarea><span asp-validation-for="SituacionActual" class="text-danger"></span></div><div class="mb-3"><label asp-for="ResultadoEsperado" class="form-label">Resultado esperado</label><textarea asp-for="ResultadoEsperado" class="form-control" rows="2"></textarea><span asp-validation-for="ResultadoEsperado" class="text-danger"></span></div></section><section><h2 class="h5">Fechas y medición</h2><div class="row"><div class="col-md-6 mb-3"><label asp-for="FechaInicio" class="form-label">Fecha de inicio</label><input asp-for="FechaInicio" class="form-control" type="date"/></div><div class="col-md-6 mb-3"><label asp-for="FechaObjetivo" class="form-label">Fecha objetivo (opcional)</label><input asp-for="FechaObjetivo" class="form-control" type="date"/></div></div><div class="mb-3"><label asp-for="MetricaProgreso" class="form-label">Métrica de progreso</label><input asp-for="MetricaProgreso" class="form-control" placeholder="Ejemplo: sesiones por semana"/><span asp-validation-for="MetricaProgreso" class="text-danger"></span></div></section>
