@model DeleteConfirmationViewModel
@{ViewData["Titulo"]="Eliminar acción";}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.MetaId">Meta</a></li><li class="breadcrumb-item active">Confirmación</li></ol></nav>
<div class="card border-danger"><div class="card-header bg-white"><h1 class="h4 mb-0">@(Model.WillArchive?"Archivar acción":"Eliminar acción")</h1></div><div class="card-body"><p>Vas a quitar la acción <strong>@Model.Titulo</strong>.</p>
@if(Model.WillArchive){<div class="alert alert-warning">La acción tiene actividad o versiones relacionadas. Se archivará, se conservará el historial y se quitarán únicamente las ocurrencias pendientes futuras sin registro.</div>}else{<div class="alert alert-danger">La acción pertenece a un borrador sin actividad y se eliminará definitivamente.</div>}
<p class="small">Versiones: @Model.Acciones · Ocurrencias: @Model.Occurrences · Registros: @Model.Logs · Ajustes: @Model.Revisiones</p>
<form asp-action="DeleteActionConfirmed" asp-route-id="@Model.Id" method="post" data-confirm-form><div class="mb-3"><label class="form-label" for="reason">Motivo (opcional)</label><textarea class="form-control" id="reason" name="reason" rows="3"></textarea></div><div class="d-flex gap-2"><button class="btn btn-danger" type="submit">Confirmar @(Model.WillArchive?"archivo":"eliminación") <span class="spinner-border spinner-border-sm d-none" data-spinner></span></button><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.MetaId">Cancelar</a></div></form></div></div>
<script>document.querySelector('[data-confirm-form]')?.addEventListener('submit',function(){const b=this.querySelector('button[type=submit]');b.disabled=true;b.querySelector('[data-spinner]').classList.remove('d-none');});</script>
