@using Kaizen.Web.Services
@model Meta
@{var p=(GoalProgressViewModel)ViewBag.Progress;var timeline=(List<GoalHistoryItemViewModel>)ViewBag.History;var due=(bool)ViewBag.ReviewDue;ViewData["Titulo"]=Model.Titulo;}
@if(TempData["SuccessMessage"] is string success){<div class="alert alert-success">@success</div>}
@if(TempData["ErrorMessage"] is string error){<div class="alert alert-danger">@error</div>}
@if(Model.Estado==EstadoMeta.Archivada){<div class="alert alert-secondary"><strong>Meta archivada.</strong> Esta vista es de solo lectura. El historial y los registros se conservaron.</div>}
<div class="text-end mb-3"><a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@Model.Id">Eliminar meta</a></div>
@if(Model.Estado!=EstadoMeta.Archivada){<div class="text-end mb-3">@foreach(var action in Model.Acciones.Where(x=>x.Estado==EstadoAccion.Activa&&x.VigenteHasta is null)){<a class="btn btn-outline-primary btn-sm ms-2" asp-action="EditAction" asp-route-id="@action.Id">Modificar acción: @action.Nombre</a><a class="btn btn-outline-danger btn-sm ms-2" asp-action="DeleteAction" asp-route-id="@action.Id">Eliminar acción</a>}</div>}
@if(due){<div class="alert alert-warning"><strong>Revisión Kaizen pendiente.</strong> La fecha planificada era el @Model.FechaProximaRevision?.ToString("dd/MM/yyyy").</div>}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li><li class="breadcrumb-item"><a asp-action="Index">Metas</a></li><li class="breadcrumb-item active">Detalle</li></ol></nav>
<div class="page-header"><div><h1 class="h3 mb-1">@Model.Titulo</h1><p class="mb-2">@Model.Descripcion</p><span class="badge text-bg-@p.BootstrapColor">@p.Label</span></div><div class="d-flex flex-wrap gap-2">@if(Model.Estado==EstadoMeta.Activa){<a class="btn btn-primary" asp-controller="Reviews" asp-action="Create" asp-route-goalId="@Model.Id">Realizar revisión Kaizen</a><a class="btn btn-outline-primary" asp-action="AddAction" asp-route-id="@Model.Id">Agregar acción</a>}<a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar meta</a></div></div>
<div class="row g-4"><div class="col-lg-8">
<section class="card mb-4"><div class="card-header bg-white d-flex justify-content-between"><h2 class="section-title mb-0">Plan de acción y versiones</h2><span>@Model.Acciones.Count versiones</span></div>
@if(!Model.Acciones.Any()){<div class="empty-state border-0">No hay acciones definidas.</div>}else{<div class="table-responsive"><table class="table mb-0"><thead><tr><th>Acción</th><th>Versión y vigencia</th><th>Configuración</th><th>Estado</th></tr></thead><tbody>
@foreach(var action in Model.Acciones.OrderBy(x=>x.SerieAccionId).ThenByDescending(x=>x.Version)){<tr><td><strong>@action.Nombre</strong></td><td>v@(action.Version) · @((action.VigenteDesde==default?action.FechaInicio:action.VigenteDesde).ToString("dd/MM/yyyy")) — @(action.VigenteHasta?.ToString("dd/MM/yyyy")??"actual")</td><td>@ReviewService.Describe(action)</td><td><span class="badge text-bg-@(action.Estado==EstadoAccion.Activa?"success":action.Estado==EstadoAccion.Pausada?"warning":"secondary")">@(action.Estado==EstadoAccion.Activa?"Activa":action.Estado==EstadoAccion.Pausada?"Pausada":"Cerrada")</span></td></tr>}
</tbody></table></div>}</section>
<section class="card mb-4"><div class="card-header bg-white"><h2 class="section-title mb-0">Análisis inicial</h2></div><div class="card-body">@if(Model.Evaluacion is null){<p>No se completó el análisis inicial.</p>}else{<dl class="row mb-0"><dt class="col-sm-4">Situación inicial</dt><dd class="col-sm-8">@Model.Evaluacion.DondeEstoy</dd><dt class="col-sm-4">Obstáculos</dt><dd class="col-sm-8">@Model.Evaluacion.Obstaculos</dd><dt class="col-sm-4">Mejora pequeña</dt><dd class="col-sm-8">@Model.Evaluacion.MejoraMasPequena</dd></dl>}</div></section>
<section class="card" id="history"><div class="card-header bg-white d-flex justify-content-between"><h2 class="section-title mb-0">Historial</h2><span>Más reciente primero</span></div>
@if(!timeline.Any()){<div class="empty-state border-0">Todavía no hay eventos de historial disponibles.</div>}else{<div class="list-group list-group-flush">@foreach(var item in timeline){<article class="list-group-item"><div class="d-flex justify-content-between gap-2"><strong>@item.Tipo</strong><time>@item.FechaOcurrencia.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time></div><p class="mb-1">@item.Descripcion</p>@if(item.ValoresAnteriores is not null||item.ValoresNuevos is not null){<div class="small"><div><strong>Anterior:</strong> @(item.ValoresAnteriores??"—")</div><div><strong>Nuevo:</strong> @(item.ValoresNuevos??"—")</div></div>}@if(item.Motivo is not null){<div class="small"><strong>Motivo:</strong> @item.Motivo</div>}</article>}</div><div class="card-footer bg-white"><a class="btn btn-outline-primary btn-sm" asp-route-id="@Model.Id" asp-route-historyPage="@((int)ViewBag.HistoryPage+1)" asp-fragment="history">Ver eventos anteriores</a></div>}</section>
</div><aside class="col-lg-4"><div class="card mb-4"><div class="card-header bg-white"><h2 class="section-title mb-0">Progreso semanal</h2></div><div class="card-body"><div class="progress mb-2"><div class="progress-bar bg-@p.BootstrapColor" style="width:@p.Percentage%"></div></div><strong>@p.Percentage%</strong><p>@p.Label</p></div></div><div class="card"><div class="card-header bg-white"><h2 class="section-title mb-0">Próxima revisión</h2></div><div class="card-body"><p>@(Model.FechaProximaRevision?.ToString("dd/MM/yyyy")??"Sin fecha programada")</p>@if(Model.Estado==EstadoMeta.Activa){<a class="btn btn-primary w-100" asp-controller="Reviews" asp-action="Create" asp-route-goalId="@Model.Id">Realizar revisión Kaizen</a>}</div></div></aside></div>
