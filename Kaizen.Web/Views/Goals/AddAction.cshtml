@model ActionFormViewModel
@{ViewData["Titulo"]="Agregar acción";}<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li><li class="breadcrumb-item"><a asp-controller="Goals" asp-action="Index">Metas</a></li><li class="breadcrumb-item"><a asp-controller="Goals" asp-action="Details" asp-route-id="@Model.MetaId">Detalle</a></li><li class="breadcrumb-item active">Agregar acción</li></ol></nav><div class="page-header"><div><h1 class="h3 mb-1">Agregar acción</h1><p class="mb-0">Definí una acción pequeña y fácil de realizar.</p></div></div><div class="card"><div class="card-body"><form asp-controller="Goals" asp-action="AddAction" asp-route-id="@Model.MetaId" method="post" id="actionForm">@Html.AntiForgeryToken()<input asp-for="MetaId" type="hidden"/><div asp-validation-summary="All" class="alert alert-danger" role="alert"></div><div class="mb-3"><label asp-for="Nombre" class="form-label">Nombre de la acción</label><input asp-for="Nombre" class="form-control"/><span asp-validation-for="Nombre" class="text-danger"></span></div><div class="mb-3"><label asp-for="Descripcion" class="form-label">Descripción (opcional)</label><textarea asp-for="Descripcion" class="form-control" rows="2"></textarea><span asp-validation-for="Descripcion" class="text-danger"></span></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="Frecuencia" class="form-label">Frecuencia</label><select asp-for="Frecuencia" class="form-select" id="frequency"><option value="0">Diaria</option><option value="1">Días específicos</option><option value="2">Semanal</option><option value="3">Fecha específica</option></select><span asp-validation-for="Frecuencia" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="Hora" class="form-label">Hora (opcional)</label><input asp-for="Hora" type="time" class="form-control"/><span asp-validation-for="Hora" class="text-danger"></span></div></div><div class="mb-3" id="weekdayPanel" hidden><label class="form-label">Días de la semana</label><div class="d-flex flex-wrap gap-3">@foreach(var d in new[]{("1","Lunes"),("2","Martes"),("3","Miércoles"),("4","Jueves"),("5","Viernes"),("6","Sábado"),("0","Domingo")}){<div class="form-check"><input class="form-check-input weekday" type="checkbox" value="@d.Item1" id="day@d.Item1"/><label class="form-check-label" for="day@d.Item1">@d.Item2</label></div>}</div><input asp-for="DiasSemana" type="hidden"/><span asp-validation-for="DiasSemana" class="text-danger"></span></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="FechaInicio" class="form-label">Fecha de inicio</label><input asp-for="FechaInicio" type="date" class="form-control"/><span asp-validation-for="FechaInicio" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="FechaFin" class="form-label">Fecha de finalización (opcional)</label><input asp-for="FechaFin" type="date" class="form-control"/><span asp-validation-for="FechaFin" class="text-danger"></span></div></div><div class="row"><div class="col-md-4 mb-3"><label asp-for="DificultadEstimada" class="form-label">Dificultad (1 a 5)</label><input asp-for="DificultadEstimada" type="number" min="1" max="5" class="form-control"/><span asp-validation-for="DificultadEstimada" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="CantidadObjetivo" class="form-label">Cantidad (opcional)</label><input asp-for="CantidadObjetivo" class="form-control"/><span asp-validation-for="CantidadObjetivo" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="UnidadMetrica" class="form-label">Unidad</label><input asp-for="UnidadMetrica" class="form-control" placeholder="minutos, vasos..."/><span asp-validation-for="UnidadMetrica" class="text-danger"></span></div></div><div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Guardar acción</button><a class="btn btn-outline-secondary" asp-controller="Goals" asp-action="Details" asp-route-id="@Model.MetaId">Cancelar</a></div></form></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>const frequency=document.getElementById('frequency'),panel=document.getElementById('weekdayPanel'),hidden=document.getElementById('DiasSemana'),checks=document.querySelectorAll('.weekday');function toggle(){panel.hidden=frequency.value!=='1'}frequency.addEventListener('change',toggle);checks.forEach(x=>x.addEventListener('change',()=>hidden.value=[...checks].filter(c=>c.checked).map(c=>c.value).join(',')));toggle();</script>}
