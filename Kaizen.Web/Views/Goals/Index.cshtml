@model IEnumerable<GoalProgressViewModel>
@if(TempData["SuccessMessage"] is string success){<div class="alert alert-success" role="status">@success</div>}
@if(TempData["ErrorMessage"] is string error){<div class="alert alert-danger" role="alert">@error</div>}
<div class="mb-3"><a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-archived="@(!(bool)ViewBag.ShowArchived)">@((bool)ViewBag.ShowArchived?"Ver metas actuales":"Ver metas archivadas")</a></div>
@if(Model.Any(x=>x.Meta.Estado==EstadoMeta.Borrador)){<div class="alert alert-secondary"><strong>Borradores:</strong> @foreach(var draft in Model.Where(x=>x.Meta.Estado==EstadoMeta.Borrador)){<a class="btn btn-outline-primary btn-sm ms-2" asp-action="Create" asp-route-id="@draft.Meta.Id">Continuar “@draft.Meta.Titulo”</a>}</div>}
@{ViewData["Titulo"]="Metas";}<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li><li class="breadcrumb-item active">Metas</li></ol></nav><div class="page-header"><div><h1 class="h3 mb-1">Metas</h1><p class="mb-0">Consultá el estado y el avance de tus metas.</p></div><a class="btn btn-primary" asp-action="Create">Nueva meta</a></div>@if(!Model.Any()){<div class="empty-state"><h2 class="h5">Todavía no creaste una meta</h2><p>Comenzá definiendo qué querés mejorar.</p><a class="btn btn-primary" asp-action="Create">Nueva meta</a></div>}else{<div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Meta</th><th>Área</th><th>Estado</th><th>Progreso semanal</th><th>Fecha objetivo</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td><strong>@item.Meta.Titulo</strong><div class="small">@item.Meta.Descripcion</div></td><td>@item.Meta.AreaPersonal?.Nombre</td><td><span class="badge text-bg-@item.BootstrapColor">@item.Label</span></td><td style="min-width:140px"><div class="progress"><div class="progress-bar bg-@item.BootstrapColor" style="width:@item.Percentage%"></div></div><small>@item.Percentage%</small></td><td>@(item.Meta.FechaObjetivo?.ToString("dd/MM/yyyy")??"Sin fecha")</td><td><a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@item.Meta.Id">Ver detalle</a></td></tr>}</tbody></table></div></div>}
