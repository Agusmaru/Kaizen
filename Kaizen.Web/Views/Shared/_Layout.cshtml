<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Titulo"] - Kaizen</title>
    <link rel="icon" type="image/svg+xml" href="~/images/kaizen-logo.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/kaizen-logo-32.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="~/images/kaizen-logo-192.png" />
    <link rel="manifest" href="~/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app-shell">
            <aside class="app-sidebar" id="appSidebar">
                <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Kaizen, ir al inicio">
                    <img class="brand-logo" src="~/images/kaizen-logo.svg" alt="" aria-hidden="true" /><span>Kaizen</span>
                </a>
                <nav class="side-nav" aria-label="Navegación principal">
                    <a class="side-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 11.5 12 4l9 7.5v8a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg><span>Inicio</span></a>
                    <a class="side-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Goals" ? "active" : "")" asp-controller="Goals" asp-action="Index"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><path d="m15 9 5-5m0 0v4m0-4h-4"/></svg><span>Metas</span></a>
                    <a class="side-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Calendar" ? "active" : "")" asp-controller="Calendar" asp-action="Index"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4m8-4v4M3 10h18"/></svg><span>Calendario</span></a>
                    <a class="side-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reviews" ? "active" : "")" asp-controller="Reviews" asp-action="Index"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M9 5h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2"/><rect x="8" y="3" width="8" height="4" rx="1"/><path d="M8 12h8m-8 4h6"/></svg><span>Revisiones</span></a>
                </nav>
                <div class="sidebar-account"><span class="account-avatar">@((User.Identity.Name ?? "A").Substring(0, 1).ToUpperInvariant())</span><span class="account-name">@User.Identity.Name</span><form asp-controller="Cuenta" asp-action="Salir" method="post"><button class="logout-button" type="submit" title="Salir" aria-label="Salir"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M10 17l5-5-5-5m5 5H3m12-9h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/></svg></button></form></div>
            </aside>
            <header class="mobile-header"><button class="mobile-menu" type="button" data-sidebar-toggle aria-label="Abrir menú"><span></span><span></span><span></span></button><a class="brand" asp-controller="Home" asp-action="Index"><img class="brand-logo" src="~/images/kaizen-logo.svg" alt="" aria-hidden="true" /><span>Kaizen</span></a></header>
            <main class="app-content">@RenderBody()</main>
        </div>
        <div class="sidebar-backdrop" data-sidebar-toggle></div>
    }
    else if (ViewContext.RouteData.Values["controller"]?.ToString() == "Cuenta" &&
             ViewContext.RouteData.Values["action"]?.ToString() is "Ingresar" or "Registrarse")
    {
        <main class="auth-page-main">@RenderBody()</main>
    }
    else if (ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
             ViewContext.RouteData.Values["action"]?.ToString() == "Index")
    {
        <main class="landing-page-main">@RenderBody()</main>
    }
    else
    {
        <header><nav class="navbar navbar-dark bg-primary"><div class="container"><a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">Kaizen</a><div class="ms-auto d-flex gap-2"><a class="btn btn-outline-light btn-sm" asp-controller="Cuenta" asp-action="Ingresar">Ingresar</a><a class="btn btn-light btn-sm" asp-controller="Cuenta" asp-action="Registrarse">Registrarse</a></div></div></nav></header>
        <main class="container py-4">@RenderBody()</main>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>document.querySelectorAll('[data-sidebar-toggle]').forEach(x=>x.addEventListener('click',()=>document.body.classList.toggle('sidebar-open')));</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
