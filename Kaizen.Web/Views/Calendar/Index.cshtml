@{ViewData["Titulo"]="Calendario";var initial=(DateOnly)ViewBag.InitialDate;}
@section Styles{<link rel="stylesheet" href="~/css/pages.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/calendar.css" asp-append-version="true"/>}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li><li class="breadcrumb-item active">Calendario</li></ol></nav>
<header class="page-hero calendar-hero"><div><span class="page-eyebrow">Tu ritmo diario</span><h1>Calendario</h1><p>Registrá tus acciones y mantené visible la constancia de cada día.</p></div><div class="calendar-controls"><div class="view-switch" role="group" aria-label="Tipo de vista"><button id="month-view" class="btn btn-primary" type="button">Mes</button><button id="week-view" class="btn btn-outline-primary" type="button">Semana</button></div><div class="range-switch"><button id="previous-range" class="btn btn-outline-primary" type="button" aria-label="Período anterior">← <span>Anterior</span></button><button id="today-range" class="btn btn-outline-primary" type="button">Hoy</button><button id="next-range" class="btn btn-outline-primary" type="button" aria-label="Período siguiente"><span>Siguiente</span> →</button></div></div></header>
<div id="calendar-feedback" class="alert d-none" role="status" aria-live="polite"></div>
<div class="card calendar-card" id="calendar" data-initial-date="@initial.ToString("yyyy-MM-dd")" data-events-url="@Url.Action("Events","Calendar")" data-log-url="@Url.Action("Registro","Calendar")">
 <div class="card-header bg-white"><span class="calendar-title-label">Período seleccionado</span><h2 id="calendar-title" class="section-title mb-0 text-capitalize"></h2></div>
 <div id="calendar-loading" class="py-5 text-center" role="status"><div class="spinner-border text-primary" aria-hidden="true"></div><p class="mt-2 mb-0">Cargando calendario…</p></div>
 <div id="calendar-error" class="alert alert-danger m-3 d-none" role="alert"></div>
 <div id="calendar-content" class="list-group list-group-flush" aria-live="polite"></div>
</div>
<form id="antiforgery-source" class="d-none">@Html.AntiForgeryToken()</form>
@section Scripts {<script src="~/js/calendar.js" asp-append-version="true"></script>}
