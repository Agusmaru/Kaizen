@model RegistroViewModel
@{ ViewData["Titulo"] = "Registrarse"; }
@section Styles { <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" /> }

<div class="login-shell register-shell">
    <section class="login-story" aria-label="Kaizen, mejora continua">
        <header class="login-brand-row">
            <a class="login-brand" asp-controller="Home" asp-action="Index" aria-label="Kaizen, ir al inicio"><img class="login-brand-logo" src="~/images/kaizen-logo.svg" alt="" aria-hidden="true" /><span>Kaizen</span></a>
            <a class="mobile-register-link" asp-action="Ingresar">Ya tengo cuenta</a>
        </header>
        <div class="story-copy"><h1>Creá tu cuenta.<br /><strong>Empezá tu camino.</strong></h1><p>Registrate para convertir tus objetivos en pequeños pasos que puedas sostener.</p></div>
        <div class="progress-journey" aria-hidden="true">
            <span class="journey-dots"></span>
            <div class="journey-step step-one"><span class="journey-ring" style="--journey:25">25%</span></div>
            <div class="journey-step step-two"><span class="journey-check">✓</span><span class="journey-ring" style="--journey:50">50%</span></div>
            <div class="journey-step step-three"><span class="journey-check">✓</span><span class="journey-ring" style="--journey:75">75%</span><span class="journey-flag">⚑</span></div>
            <svg class="journey-path" viewBox="0 0 580 230" preserveAspectRatio="none"><path d="M22 205 C120 185,135 152,220 155 S310 115,350 103 S445 110,500 25" /></svg>
        </div>
    </section>

    <section class="login-workspace">
        <nav class="auth-nav" aria-label="Acceso a la cuenta"><a asp-action="Ingresar">Ingresar</a><a class="active" asp-action="Registrarse">Registrarse</a></nav>
        <div class="login-card register-card">
            <div class="login-heading">
                <p><span class="register-heading-icon" aria-hidden="true">+</span> Nueva cuenta</p>
                <h2>Registrate en Kaizen</h2>
                <span>Completá estos datos para crear un usuario nuevo.</span>
            </div>
            <form asp-action="Registrarse" method="post" novalidate>
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                <div class="auth-field">
                    <label asp-for="Correo">Correo</label>
                    <input asp-for="Correo" class="form-control" autocomplete="username" placeholder="tu@correo.com" />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>
                <div class="auth-field">
                    <label asp-for="Clave">Contraseña</label>
                    <div class="password-field"><input asp-for="Clave" class="form-control" autocomplete="new-password" /><button type="button" class="password-toggle" data-password-toggle aria-label="Mostrar contraseña" aria-pressed="false"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg></button></div>
                    <span asp-validation-for="Clave" class="text-danger"></span>
                </div>
                <div class="auth-field">
                    <label asp-for="ConfirmacionClave">Repetir contraseña</label>
                    <div class="password-field"><input asp-for="ConfirmacionClave" class="form-control" autocomplete="new-password" /><button type="button" class="password-toggle" data-password-toggle aria-label="Mostrar contraseña" aria-pressed="false"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="2.5"/></svg></button></div>
                    <span asp-validation-for="ConfirmacionClave" class="text-danger"></span>
                </div>
                <button class="btn btn-primary login-submit" type="submit">Crear mi cuenta</button>
            </form>
            <p class="login-register">¿Ya tenés una cuenta? <a asp-action="Ingresar">Ingresá</a></p>
        </div>
    </section>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/auth.js" asp-append-version="true"></script> }
